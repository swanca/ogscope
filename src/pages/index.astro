---
import Base from '../layouts/Base.astro';
import '../styles/cards.css';
import { PLATFORMS } from '../lib/platforms';
import { renderCard, type CardData } from '../lib/card';

// The hero demo shows our own card. Dogfooding, and it means the demo is never
// out of date with what the tool actually produces.
const demo: CardData = {
  title: 'OGScope: see your link before anyone else does',
  description:
    'Paste a URL and see the exact card every platform will render, plus the tags you need to fix. No account needed.',
  image: '/demo-card.svg',
  siteName: 'OGScope',
  domain: 'ogscope.app',
  themeColor: '#5b3df5',
  cardType: 'summary_large_image',
};

const EXAMPLES = ['github.com', 'wikipedia.org', 'notion.so'];
---

<Base
  title="OGScope: check how your link looks on X, LinkedIn and Slack"
  description="Paste a URL and see the exact preview card every platform renders, with the Open Graph tags you need to fix. Free, no sign up."
  path="/"
  ogTitle="See your link before anyone else does"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Link preview checker</p>
        <h1>See your link before anyone else does.</h1>
        <p class="lede">
          Paste a URL. OGScope renders the exact card that X, LinkedIn, Slack, WhatsApp and five
          other platforms will show, then tells you which tags to fix.
        </p>

        <form class="scan" id="scan-form" novalidate>
          <label class="visually-hidden" for="scan-url">URL to check</label>
          <div class="scan-field">
            <span class="scan-prefix" aria-hidden="true">https://</span>
            <input
              id="scan-url"
              name="url"
              type="text"
              inputmode="url"
              autocomplete="url"
              spellcheck="false"
              placeholder="yoursite.com/page"
              required
            />
          </div>
          <button class="btn" type="submit" id="scan-button">Check link</button>
        </form>

        <p class="examples">
          <span class="examples-label">Try</span>
          {
            EXAMPLES.map((host) => (
              <button type="button" class="example" data-example={host}>
                {host}
              </button>
            ))
          }
        </p>
      </div>

      {/* The signature: one link, rendered as each platform really shows it. */}
      <div class="demo" id="demo">
        <div class="demo-stage">
          {
            PLATFORMS.map((p, i) => (
              <div class:list={['demo-slide', i === 0 && 'is-active']} data-slide={p.id}>
                <Fragment set:html={renderCard(p, demo)} />
              </div>
            ))
          }
        </div>
        <div class="demo-tabs" role="tablist" aria-label="Platform preview">
          {
            PLATFORMS.map((p, i) => (
              <button
                type="button"
                role="tab"
                class:list={['demo-tab', i === 0 && 'is-active']}
                data-tab={p.id}
                style={`--pc:${p.brandColor}`}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                {p.short}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="wrap" id="report" hidden aria-live="polite"></section>

  <section class="wrap section" id="how">
    <p class="eyebrow">What actually breaks</p>
    <h2>Four reasons a preview looks wrong</h2>
    <div class="reasons">
      <article>
        <h3>The image is too heavy</h3>
        <p>
          WhatsApp drops any <span class="tag">og:image</span> over 300KB without telling you. The card
          works everywhere else, which is why this one is so hard to spot.
        </p>
      </article>
      <article>
        <h3>The card type is missing</h3>
        <p>
          X will not infer a card from your Open Graph tags. With no <span class="tag">twitter:card</span>
          it posts a bare link and ignores the image you set.
        </p>
      </article>
      <article>
        <h3>The old version is cached</h3>
        <p>
          LinkedIn holds a preview for about a week and Facebook holds one indefinitely. Fixing the
          tags changes nothing until the cache clears.
        </p>
      </article>
      <article>
        <h3>The path is relative</h3>
        <p>
          Facebook does not resolve a relative image path. It has to be a full URL with
          <span class="tag">https://</span> on the front, or the image is dropped.
        </p>
      </article>
    </div>
  </section>

  <section class="wrap section">
    <p class="eyebrow">Per platform guides</p>
    <h2>Every platform reads different tags</h2>
    <p class="section-lede">
      Each guide lists the tags that platform reads, the image size it wants, and the quirks that
      catch people out.
    </p>
    <div class="platform-grid">
      {
        PLATFORMS.map((p) => (
          <a class="platform-card" href={`/fix/${p.id}`} style={`--pc:${p.brandColor}`}>
            <span class="platform-rule" />
            <h3>{p.name}</h3>
            <p>
              {p.image.recommended.width}x{p.image.recommended.height}, title cuts at {p.titleLimit}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hero {
    padding: 72px 0 64px;
    border-bottom: 1px solid var(--rule);
    background:
      linear-gradient(var(--paper), var(--paper)),
      repeating-linear-gradient(90deg, transparent, transparent 119px, var(--rule) 119px, var(--rule) 120px);
    background-blend-mode: normal;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: start;
  }

  .hero-copy h1 {
    margin: 14px 0 18px;
    max-width: 13ch;
  }

  .lede {
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 46ch;
    line-height: 1.5;
  }

  .scan {
    display: flex;
    gap: 10px;
    margin-top: 28px;
    max-width: 520px;
  }

  .scan-field {
    flex: 1;
    display: flex;
    align-items: center;
    background: var(--panel);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    padding-left: 12px;
    min-width: 0;
    transition: border-color 0.15s ease;
  }

  .scan-field:focus-within {
    border-color: var(--ink);
    box-shadow: 0 0 0 3px rgba(11, 17, 27, 0.08);
  }

  .scan-prefix {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--faint);
    flex: none;
  }

  .scan input {
    flex: 1;
    border: 0;
    background: none;
    padding: 12px 12px 12px 2px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink);
    min-width: 0;
  }

  .scan input:focus {
    outline: none;
  }

  .examples-label {
    margin-right: 8px;
  }

  .examples {
    margin-top: 14px;
    font-size: 0.8125rem;
    color: var(--faint);
  }

  .example {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: none;
    border: 0;
    border-bottom: 1px dashed var(--rule-strong);
    color: var(--muted);
    cursor: pointer;
    padding: 0 0 1px;
    margin-right: 6px;
  }

  .example:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  /* ---- hero demo ----
     The tab and slide rules live in the global block below, because the
     results panel builds the same markup at runtime and Astro's scoped styles
     only reach elements that existed at build time. */

  /* ---- sections ---- */

  .section {
    padding-top: 72px;
  }

  .section-lede {
    color: var(--muted);
    max-width: 54ch;
    margin-top: 12px;
  }

  .reasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    margin-top: 28px;
  }

  .reasons article {
    background: var(--panel);
    padding: 22px 20px 24px;
  }

  .reasons h3 {
    margin-bottom: 8px;
  }

  .reasons p {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 12px;
    margin-top: 28px;
  }

  .platform-card {
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 18px 18px 20px;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .platform-card:hover {
    border-color: var(--pc);
  }

  .platform-rule {
    display: block;
    width: 26px;
    height: 3px;
    border-radius: 2px;
    background: var(--pc);
    margin-bottom: 14px;
  }

  .platform-card p {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    margin-top: 6px;
  }

  @media (max-width: 940px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .hero {
      padding-top: 48px;
    }
    .hero-copy h1 {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .scan {
      flex-direction: column;
    }
    .demo-stage {
      min-height: 300px;
    }
  }
</style>

<script>
  import { PLATFORMS, getPlatform } from '../lib/platforms';
  import { renderCard, cardDataFor, escapeHtml } from '../lib/card';
  import type { ScanResult } from '../lib/scan';

  /* ---------------- hero demo ---------------- */

  const demo = document.getElementById('demo');
  if (demo) {
    const slides = [...demo.querySelectorAll<HTMLElement>('.demo-slide')];
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>('.demo-tab')];
    let index = 0;
    let timer: number | undefined;

    const show = (next: number) => {
      index = next % slides.length;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === index));
      tabs.forEach((t, i) => {
        t.classList.toggle('is-active', i === index);
        t.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      stop();
      timer = window.setInterval(() => show(index + 1), 2600);
    };

    tabs.forEach((tab, i) =>
      tab.addEventListener('click', () => {
        stop(); // Once someone picks a platform, stop moving it under them.
        show(i);
      }),
    );

    demo.addEventListener('mouseenter', stop);
    start();
  }

  /* ---------------- scanning ---------------- */

  const form = document.getElementById('scan-form') as HTMLFormElement | null;
  const input = document.getElementById('scan-url') as HTMLInputElement | null;
  const button = document.getElementById('scan-button') as HTMLButtonElement | null;
  const report = document.getElementById('report');

  document.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((el) =>
    el.addEventListener('click', () => {
      if (!input) return;
      input.value = el.dataset.example ?? '';
      form?.requestSubmit();
    }),
  );

  function escapeAttr(value: string): string {
    return escapeHtml(value);
  }

  function statusFor(result: ScanResult, platformId: string): 'error' | 'warning' | 'ok' {
    const relevant = result.audit.issues.filter((i) => i.platforms.includes(platformId));
    if (relevant.some((i) => i.severity === 'error')) return 'error';
    if (relevant.some((i) => i.severity === 'warning')) return 'warning';
    return 'ok';
  }

  function renderReport(result: ScanResult): string {
    const { audit } = result;
    const statuses = PLATFORMS.map((p) => ({ platform: p, status: statusFor(result, p.id) }));
    const broken = statuses.filter((s) => s.status === 'error').length;

    const summary =
      broken > 0
        ? `${broken} platform${broken === 1 ? '' : 's'} will render this link badly.`
        : audit.issues.length === 0
          ? 'Every platform renders this link correctly.'
          : 'Nothing is broken, but there is room to tighten this up.';

    // Eight squares, one per platform. Which platform is broken is the thing
    // people need to know, and a single score cannot carry that.
    const squares = statuses
      .map(
        ({ platform, status }) =>
          `<div class="pstat pstat-${status}" style="--pc:${platform.brandColor}">
             <span class="pstat-dot"></span>
             <span class="pstat-name">${platform.short}</span>
           </div>`,
      )
      .join('');

    const issues = audit.issues.length
      ? audit.issues
          .map((issue) => {
            const chips = issue.platforms
              .map((id) => getPlatform(id)?.short ?? id)
              .map((name) => `<span class="chip">${escapeHtml(name)}</span>`)
              .join('');
            const fix = issue.fix
              ? `<div class="fix"><code>${escapeHtml(issue.fix)}</code><button type="button" class="copy" data-copy="${escapeAttr(issue.fix)}">Copy</button></div>`
              : '';
            return `<li class="issue">
              <div class="issue-head">
                <span class="sev sev-${issue.severity}">${issue.severity}</span>
                <h3>${escapeHtml(issue.title)}</h3>
              </div>
              <p>${escapeHtml(issue.detail)}</p>
              ${fix}
              <div class="chips">${chips}</div>
            </li>`;
          })
          .join('')
      : `<li class="issue issue-clean"><span class="sev sev-ok">pass</span>
           <p>No problems found. Every tag these platforms read is present and within limits.</p></li>`;

    const tabs = PLATFORMS.map(
      (p, i) =>
        `<button type="button" role="tab" class="demo-tab${i === 0 ? ' is-active' : ''}" data-rtab="${p.id}" style="--pc:${p.brandColor}" aria-selected="${i === 0}">${p.short}</button>`,
    ).join('');

    const slides = PLATFORMS.map(
      (p, i) =>
        `<div class="demo-slide${i === 0 ? ' is-active' : ''}" data-rslide="${p.id}">${renderCard(
          p,
          cardDataFor(p, result.tags, result.finalUrl),
        )}</div>`,
    ).join('');

    return `
      <div class="report-head">
        <div>
          <p class="eyebrow">Scanned</p>
          <a class="report-url" href="${escapeAttr(result.finalUrl)}" target="_blank" rel="noopener nofollow">${escapeHtml(result.finalUrl)}</a>
          ${result.redirected ? `<p class="note">Redirected from the URL you entered.</p>` : ''}
        </div>
        <div class="report-grade">
          <span class="grade grade-${audit.grade}">${audit.grade}</span>
          <span class="grade-score">${audit.score}<small>/100</small></span>
        </div>
      </div>
      <p class="report-summary">${summary}</p>
      <div class="pstats">${squares}</div>
      <div class="report-body">
        <ol class="issues">${issues}</ol>
        <div class="report-preview">
          <div class="demo-tabs" role="tablist" aria-label="Platform preview">${tabs}</div>
          <div class="demo-stage">${slides}</div>
        </div>
      </div>`;
  }

  function wireReport(): void {
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-rtab]')];
    const slides = [...document.querySelectorAll<HTMLElement>('[data-rslide]')];
    tabs.forEach((tab, i) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t, j) => {
          t.classList.toggle('is-active', i === j);
          t.setAttribute('aria-selected', String(i === j));
        });
        slides.forEach((s, j) => s.classList.toggle('is-active', i === j));
      }),
    );

    document.querySelectorAll<HTMLButtonElement>('.copy').forEach((btn) =>
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        const original = btn.textContent;
        btn.textContent = 'Copied';
        window.setTimeout(() => (btn.textContent = original), 1400);
      }),
    );
  }

  function showMessage(html: string): void {
    if (!report) return;
    report.hidden = false;
    report.innerHTML = html;
  }

  async function scan(target: string): Promise<void> {
    if (!report || !button) return;
    button.disabled = true;
    button.textContent = 'Checking';
    showMessage('<div class="loading"><span class="spinner"></span>Fetching the page and its image</div>');

    try {
      const response = await fetch(`/api/scan?url=${encodeURIComponent(target)}`);
      const data = await response.json();

      if (!response.ok) {
        showMessage(
          `<div class="failure"><h3>Could not scan that URL</h3><p>${escapeHtml(data.error ?? 'Unknown error.')}</p></div>`,
        );
        return;
      }

      showMessage(renderReport(data as ScanResult));
      wireReport();
      report.scrollIntoView({ behavior: 'smooth', block: 'start' });

      const next = new URL(window.location.href);
      next.searchParams.set('url', target);
      window.history.replaceState({}, '', next);
    } catch {
      showMessage(
        '<div class="failure"><h3>Could not reach the scanner</h3><p>Check your connection and try again.</p></div>',
      );
    } finally {
      button.disabled = false;
      button.textContent = 'Check link';
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const value = input?.value.trim();
    if (value) void scan(value);
  });

  // Deep link support, so a scan result can be shared as a URL.
  const preset = new URLSearchParams(window.location.search).get('url');
  if (preset && input) {
    input.value = preset;
    void scan(preset);
  }
</script>

<style is:global>
  /* Report styles live global because the markup is injected at runtime. */

  /* Shared by the hero demo and the runtime built results panel. Global on
     purpose: scoped styles are stamped onto elements at build time, so markup
     created later by innerHTML would never match them, and the slides would
     lose their stacking and render all at once down the page. */
  .demo-stage {
    position: relative;
    min-height: 340px;
    display: grid;
    place-items: center start;
  }

  .demo-slide {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
    pointer-events: none;
    width: 100%;
  }

  .demo-slide.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .demo-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 20px;
    border-top: 1px solid var(--rule);
    padding-top: 12px;
  }

  .demo-tab {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    color: var(--faint);
    padding: 4px 8px;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .demo-tab:hover {
    color: var(--ink-soft);
  }

  /* The only chroma in the chrome: the platform's own colour, when selected. */
  .demo-tab.is-active {
    color: var(--pc);
    border-bottom-color: var(--pc);
  }
  .report-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding-top: 56px;
  }

  .report-url {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    word-break: break-all;
    display: inline-block;
    margin-top: 4px;
  }

  .note {
    color: var(--faint);
    font-size: 0.8125rem;
    margin-top: 4px;
  }

  .report-grade {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }

  .grade {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    border: 1px solid var(--rule);
  }

  .grade-A {
    color: var(--ok);
    background: var(--ok-bg);
  }
  .grade-B {
    color: var(--ok);
    background: var(--ok-bg);
  }
  .grade-C {
    color: var(--warning);
    background: var(--warning-bg);
  }
  .grade-D,
  .grade-F {
    color: var(--error);
    background: var(--error-bg);
  }

  .grade-score {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    color: var(--muted);
  }

  .grade-score small {
    font-size: 0.75rem;
    color: var(--faint);
  }

  .report-summary {
    margin-top: 18px;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .pstats {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 6px;
    margin-top: 20px;
  }

  .pstat {
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    padding: 10px 10px 9px;
    display: grid;
    gap: 7px;
  }

  .pstat-dot {
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background: var(--rule-strong);
    display: block;
  }

  .pstat-ok .pstat-dot {
    background: var(--ok);
  }
  .pstat-warning .pstat-dot {
    background: var(--warning);
  }
  .pstat-error .pstat-dot {
    background: var(--error);
  }

  .pstat-name {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .report-body {
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: 40px;
    margin-top: 36px;
    align-items: start;
  }

  .issues {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .issue {
    background: var(--panel);
    padding: 18px 20px 20px;
  }

  .issue-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .issue h3 {
    font-size: 1rem;
  }

  .issue p {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .fix {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--panel-sunk);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    padding: 8px 8px 8px 12px;
    margin-top: 12px;
    overflow: hidden;
  }

  .fix code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
    overflow-x: auto;
    white-space: nowrap;
    flex: 1;
  }

  .copy {
    background: var(--panel);
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    font-size: 0.75rem;
    padding: 4px 10px;
    cursor: pointer;
    flex: none;
  }

  .copy:hover {
    border-color: var(--ink);
  }

  .chips {
